# ===========================================================================
#  Social Media BOT - environment template
#  Copy to ".env" and fill in.  NEVER commit the real .env file.
#     cp .env.example .env && chmod 600 .env
#  Generate the two secrets with:
#     python -c "import secrets;print(secrets.token_urlsafe(48))"
#     python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ===========================================================================

# --- Core -------------------------------------------------------------------
# "production", "development" or "testing". Controls debug + cookie hardening.
APP_ENV=production

# Signs session cookies and CSRF tokens. Changing it logs everybody out.
SECRET_KEY=change-me-to-a-long-random-string

# Fernet key (44 chars, base64). Encrypts OAuth tokens at rest in the database.
# WARNING: if you lose this key every stored platform token becomes unreadable
# and each account has to be re-connected. Back it up together with the DB.
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Public URL of the web interface. Must match the OAuth redirect URI registered
# in the Google Cloud console (this value + /accounts/oauth/callback/youtube).
PUBLIC_BASE_URL=https://bot.example.com

# --- Database ---------------------------------------------------------------
# SQLite is the default and is fine for a single-server install.
# PostgreSQL example: postgresql+psycopg://user:password@localhost/socialbot
DATABASE_URL=sqlite:///data/socialbot.db

# --- Networking -------------------------------------------------------------
# The app binds to localhost only; nginx terminates TLS and proxies to it.
HOST=127.0.0.1
PORT=8000

# Set to 1 when running behind nginx/Apache so the app trusts X-Forwarded-*
# headers (needed for correct HTTPS detection and client IPs in the audit log).
BEHIND_PROXY=1

# Send session cookies over HTTPS only. Keep 1 in production.
# Set to 0 ONLY on a local test server that has no TLS certificate.
FORCE_HTTPS=1

# --- Storage paths (absolute paths recommended in production) ---------------
# Uploaded/managed video files and generated thumbnails.
MEDIA_ROOT=media
# SQLite database, scheduler job store and other runtime state.
DATA_ROOT=data
# Application log files.
LOG_ROOT=logs
LOG_LEVEL=INFO

# Largest file the web interface will accept, in megabytes.
MAX_UPLOAD_MB=2048

# --- ffmpeg -----------------------------------------------------------------
# Used to inspect and re-encode videos into the vertical Shorts format.
# Leave as-is if both binaries are on PATH; otherwise give the full path.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- Background automation --------------------------------------------------
# Master switch for the scheduler. 0 = web interface only, no automatic work.
SCHEDULER_ENABLED=1
# How often the queue worker looks for due upload jobs (minutes).
UPLOAD_POLL_MINUTES=5
# How often view/like statistics are refreshed from the platforms (minutes).
STATS_INTERVAL_MINUTES=180
# How often trend research runs (hours).
TREND_INTERVAL_HOURS=6

# --- YouTube (OAuth client from Google Cloud Console) -----------------------
# APIs to enable: "YouTube Data API v3" and "YouTube Analytics API".
# Credentials -> Create credentials -> OAuth client ID -> Web application.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Two-letter region code used for trend research (US, GB, DE, IR, ...).
YOUTUBE_TREND_REGION=US

# --- First administrator ----------------------------------------------------
# Read once by "flask create-admin" / the Ubuntu installer to seed the first
# account. Delete these two lines after the first successful login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
