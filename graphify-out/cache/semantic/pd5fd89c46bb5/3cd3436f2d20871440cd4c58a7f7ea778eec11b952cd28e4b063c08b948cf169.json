{"nodes": [{"id": "app_templates_videos_form", "label": "Video Form Template", "file_type": "code", "source_file": "app/templates/videos/form.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_templates_videos_form_rights_monetisation_gate", "label": "Rights And Monetisation Gate", "file_type": "rationale", "source_file": "app/templates/videos/form.html", "source_location": "lines 80-98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Licence type, source, reference and attribution are collected up front and drive a three-way outcome: owned/licensed material can earn, royalty-free gathers views but is excluded from revenue share, and footage whose rights cannot be stated is blocked from publishing outright - 'what gets a channel struck and demonetised'. Rights are a first-class field rather than an afterthought precisely so the block is enforceable."}, {"id": "app_templates_videos_form_shorts_conversion", "label": "Inline Shorts Re-Encode", "file_type": "rationale", "source_file": "app/templates/videos/form.html", "source_location": "lines 51-77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Short must be vertical and under three minutes, so anything else is re-encoded to 1080x1920 with ffmpeg during form submission ('keep the tab open') instead of being deferred to the worker - the operator gets an immediate verdict on the file. The media file is deliberately not replaceable on edit (delete and re-upload instead), so the edit form drops video_file and shows read-only file properties."}], "edges": [{"source": "app_web_videos_create", "target": "app_templates_videos_form", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "app/templates/videos/form.html", "source_location": null, "weight": 1.0}, {"source": "app_web_videos_edit", "target": "app_templates_videos_form", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "app/templates/videos/form.html", "source_location": null, "weight": 1.0}, {"source": "app_templates_videos_form", "target": "app_web_videos_detail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/videos/form.html", "source_location": "line 102", "weight": 1.0}, {"source": "app_templates_videos_form", "target": "app_web_videos_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/videos/form.html", "source_location": "line 102", "weight": 1.0}, {"source": "app_templates_videos_form_rights_monetisation_gate", "target": "app_templates_videos_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/videos/form.html", "source_location": "lines 80-98", "weight": 1.0}, {"source": "app_templates_videos_form_shorts_conversion", "target": "app_templates_videos_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/videos/form.html", "source_location": "lines 51-77", "weight": 1.0}, {"source": "app_templates_videos_form_shorts_conversion", "target": "app_web_videos_convert", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "app/templates/videos/form.html", "source_location": "lines 56-62", "weight": 1.0}], "hyperedges": []}