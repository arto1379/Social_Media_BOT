{"nodes": [{"id": "app_templates_trends_index", "label": "Trends Index Template", "file_type": "code", "source_file": "app/templates/trends/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_templates_trends_index_no_reuse_policy", "label": "Trend-As-Subject, Never Re-Upload", "file_type": "rationale", "source_file": "app/templates/trends/index.html", "source_location": "lines 23-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A trend records only the topic and its keywords - the bot never downloads or re-posts source footage. Justified three ways in the UI copy: re-uploading someone else's video is copyright infringement, is demoted as reused content, and cannot be monetised. The reference_url on the detail page is explicitly for human viewing ('watch the example and decide what to make'), not ingestion."}, {"id": "app_templates_trends_index_views_per_hour_ranking", "label": "Views-Per-Hour Trend Ranking", "file_type": "rationale", "source_file": "app/templates/trends/index.html", "source_location": "lines 8-11, 80-85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trends are ranked by views per hour rather than raw view count, so a fast-rising new topic outranks an old video that accumulated views slowly. The 0-100 score doubles as the progress-bar width; raw views and views_per_hour are surfaced underneath from trend.signals for sanity-checking the score."}], "edges": [{"source": "app_web_trends_index", "target": "app_templates_trends_index", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "app/templates/trends/index.html", "source_location": null, "weight": 1.0}, {"source": "app_templates_trends_index", "target": "app_web_trends_research", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/trends/index.html", "source_location": "line 15", "weight": 1.0}, {"source": "app_templates_trends_index", "target": "app_web_trends_detail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/trends/index.html", "source_location": "line 79", "weight": 1.0}, {"source": "app_templates_trends_index", "target": "app_web_videos_create", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/trends/index.html", "source_location": "line 99", "weight": 1.0}, {"source": "app_templates_trends_index_no_reuse_policy", "target": "app_templates_trends_index", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/trends/index.html", "source_location": "lines 23-28", "weight": 1.0}, {"source": "app_templates_trends_index_views_per_hour_ranking", "target": "app_templates_trends_index", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/trends/index.html", "source_location": "lines 8-11", "weight": 1.0}, {"source": "app_templates_trends_index_no_reuse_policy", "target": "app_templates_videos_form_rights_monetisation_gate", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "app/templates/trends/index.html", "source_location": "lines 23-28", "weight": 1.0}, {"source": "app_templates_trends_index", "target": "app_models_trend_keyword_list", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/trends/index.html", "source_location": "line 88", "weight": 1.0}], "hyperedges": []}