{"nodes": [{"id": "app_templates_base_base_layout", "label": "Base Layout Template", "file_type": "code", "source_file": "app/templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sidebar navigation plus content column, with two mutually exclusive blocks: 'content' for signed-in pages inside the chrome and 'anonymous_content' for signed-out pages such as login. Ships a data-URI SVG favicon and links only local CSS/JS, consistent with the no-CDN CSP."}, {"id": "app_templates_base_permission_aware_navigation", "label": "Permission-Aware Navigation", "file_type": "rationale", "source_file": "app/templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every nav link is wrapped in a current_user.can(Permission.X) check, and whole nav groups are hidden when the user holds none of their permissions, so a user only sees the parts of the site they can open. The view decorators enforce the same rules server-side - hiding a link is convenience, not security. Sign-out is a POST form carrying a csrf_token, matching the 'state-changing actions are POST-only, including sign-out' rule."}], "edges": [{"source": "app_templates_base_permission_aware_navigation", "target": "app_templates_base_base_layout", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/base.html", "source_location": null, "weight": 1.0}, {"source": "app_templates_base_permission_aware_navigation", "target": "readme_permission_bitmask", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "app/templates/base.html", "source_location": null, "weight": 1.0}, {"source": "app_templates_base_permission_aware_navigation", "target": "readme_security_hardening", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_fi