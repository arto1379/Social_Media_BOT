{"nodes": [{"id": "requirements_runtime_dependencies", "label": "Runtime Dependency Set", "file_type": "document", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grouped by purpose with a comment per package: the Flask ecosystem for the web tier, APScheduler for background automation, the four google-* packages for the YouTube Data and Analytics APIs, cryptography for Fernet token encryption and python-dotenv for .env, the platform-conditional WSGI servers, and requests."}, {"id": "requirements_version_pinning_policy", "label": "Bounded Version Pinning Policy", "file_type": "rationale", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every dependency carries both a '>=' lower bound so security patches are picked up on rebuild and a '<' upper bound so a major release cannot silently break a running server. Neither exact pins nor open ranges would give both properties."}, {"id": "requirements_platform_conditional_wsgi_server", "label": "Platform-Conditional WSGI Server", "file_type": "rationale", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gunicorn is installed only when platform_system != \"Windows\" and waitress only when it is, so one requirements file serves both deployment targets without a Windows install failing on a POSIX-only package."}], "edges": [{"source": "requirements_version_pinning_policy", "target": "requirements_runtime_dependencies", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "requirements.txt", "source_location": null, "weight": 1.0}, {"source": "requirements_platform_conditional_wsgi_server", "target": "requirements_runtime_dependencies", "relation": "rationale_for", "confidence": "EX