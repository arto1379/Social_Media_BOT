{"nodes": [{"id": "app_templates_settings_index", "label": "Settings Index Template", "file_type": "code", "source_file": "app/templates/settings/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_templates_settings_index_spec_driven_form", "label": "Spec-Driven Settings Form", "file_type": "concept", "source_file": "app/templates/settings/index.html", "source_location": "lines 24-80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instead of a WTForms field per setting, the template loops over grouped specs and switches on spec.kind (bool / choice / time_list / int / float / fallback text) to pick the input widget, reading the current value out of a values[spec.key] map. Adding a setting means adding one spec server-side; the template never changes."}, {"id": "app_templates_settings_index_env_secret_boundary", "label": "Env vs Database Settings Boundary", "file_type": "rationale", "source_file": "app/templates/settings/index.html", "source_location": "lines 15-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate split: secrets and paths (API keys, database URL, media directory) stay in the server .env and need a restart, while operational tuning lives in the database and takes effect on the next background cycle with no restart. Keeps credentials out of the web UI and out of any user's reach."}], "edges": [{"source": "app_web_settings_index", "target": "app_templates_settings_index", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "app/templates/settings/index.html", "source_location": null, "weight": 1.0}, {"source": "app_templates_settings_index", "target": "app_templates_settings_index_spec_driven_form", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/settings/index.html", "source_location": "lines 24-80", "weight": 1.0}, {"source": "app_templates_settings_index_env_secret_boundary", "target": "app_templates_settings_index", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/templates/settings/index.html", "source_location": "lines 15-19", "weight": 1.0}, {"source": "app_templates_settings_index_spec_driven_form", "target": "app_web_settings_index", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "app/templates/settings/index.html", "source_location": "lines 24-30", "weight": 1.0}], "hyperedges": []}